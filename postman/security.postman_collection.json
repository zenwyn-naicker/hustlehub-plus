{
  "info": {
    "name": "HustleHub+ Security",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:3443"
    }
  ],
  "item": [
    {
      "name": "Register freelancer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Final Freelancer\", \"email\": \"final-free-{{suffix}}@example.com\", \"password\": \"PartThree!12345\", \"role\": \"freelancer\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('suffix', pm.variables.replaceIn('{{$randomUUID}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "var payload = pm.response.json();",
              "pm.test('Safe envelope', () => pm.expect(payload).to.have.property('success'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login freelancer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"final-free-{{suffix}}@example.com\", \"password\": \"PartThree!12345\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "var payload = pm.response.json();",
              "pm.test('Safe envelope', () => pm.expect(payload).to.have.property('success'));",
              "pm.environment.set('freeToken', payload.data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Empty annual finance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{freeToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/finance?year=2026"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "var payload = pm.response.json();",
              "pm.test('Safe envelope', () => pm.expect(payload).to.have.property('success'));",
              "pm.test('Zero totals and twelve months', () => { pm.expect(payload.data.summary.grossCents).to.eql(0); pm.expect(payload.data.summary.taxCents).to.eql(0); pm.expect(payload.data.months).to.have.length(12); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid year",
